<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#ffffff">
    <title>{{ title }} · FOSS4CCCIs Portfolio</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cpath d='M50 4 L90 27 L90 73 L50 96 L10 73 L10 27 Z' fill='none' stroke='%233498db' stroke-width='12'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="css/styles.css">
    {% if showCatalog %}<script src="js/main.js" defer></script>{% endif %}
  </head>
  <body data-page="catalog">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell masthead">
        <a class="wordmark" href="index.html">
          <svg class="hex hex-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <path class="hex__ring" d="M50 4 L90 27 L90 73 L50 96 L10 73 L10 27 Z"/>
          </svg>
          <span class="wordmark__text">FOSS4CCCIs Portfolio</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <ul>
            <li><a href="index.html">Home</a></li>
            <li class="nav-categories">
              <span class="nav-categories__label">Categories</span>
              <ul class="nav-categories__list">
                <li><a href="network-management.html">Network Management</a></li>
                <li><a href="enabling-payments.html">Enabling Payments</a></li>
                <li><a href="managing-money.html">Managing Money</a></li>
                <li><a href="managing-community.html">Managing Community</a></li>
                <li><a href="regulatory-compliance.html">Regulatory Compliance</a></li>
              </ul>
            </li>
            <li><a href="tools.html">Tools</a></li>
            <li><a href="resources.html">Resources</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero">
        <div class="shell">
          <p class="eyebrow">{{ eyebrow }}</p>
          <h1><span class="mark">{{ title }}</span></h1>
          {% if intro %}<p class="hero__intro">{{ intro }}</p>{% endif %}
        </div>
      </section>

      {% if showCatalog %}{% include "catalog.njk" %}{% endif %}
      {% if content %}
      <section class="section">
        <div class="shell measure">
          {{ content | safe }}
        </div>
      </section>
      {% endif %}
    </main>

    <footer class="site-footer">
      <div class="shell footer-layout">
        <div>
          <p><strong>FOSS4CCCIs Portfolio</strong></p>
          <p class="footer-note">
            Data sourced from the <a href="https://docs.getgrist.com/8DBPFSG3ugAQ/FOSS4CCCIs-All-Tools-and-Platforms-v15-finalmergedtoolsplatformscsv-2026-06-1017-15">FOSS4CCCIs Database</a>.
          </p>
          <p class="footer-note">
            <a href="{% editUrl page.inputPath %}">Edit this page on GitHub</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>